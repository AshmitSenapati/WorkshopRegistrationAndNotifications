# Application Environment
NODE_ENV=development
PORT=3000
MOCK_PORT=4000
LOG_LEVEL=info

# Database (Requires a replica set deployment for multi-document transactions, e.g. MongoDB Atlas or local replica set)
MONGODB_URI=mongodb://127.0.0.1:27017/workshop_db?replicaSet=rs0
# Or MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/workshop_db?retryWrites=true&w=majority

# Demonstration Isolated Ports (Used by npm run demo)
DEMO_PORT=3050
DEMO_MOCK_PORT=4050

# Mock Notification Service Target
MOCK_NOTIFICATION_URL=http://localhost:4000/notifications

# Background Worker Settings
WORKER_POLL_INTERVAL_MS=500
WORKER_BATCH_SIZE=10
WORKER_LEASE_DURATION_MS=15000
WORKER_MAX_ATTEMPTS=5
WORKER_INITIAL_BACKOFF_MS=1000
WORKER_BACKOFF_FACTOR=2
WORKER_MAX_BACKOFF_MS=60000
WORKER_REQUEST_TIMEOUT_MS=3000
